{
  "_comment": "Bash 위험 패턴 정의 — bash_safety 훅(PreToolUse)에서 사용. L4=즉시 차단, L3=경고+사유 요구",
  "_version": "1.0",
  "_updated": "2026-04-30",
  "L4_block": [
    {
      "pattern": "rm\\s+-rf\\s+(/|/\\*|~|\\$HOME|\\$\\{HOME\\}|\\.\\.|\\*)",
      "reason": "루트·홈·상위·전체 삭제 위험"
    },
    {
      "pattern": "rm\\s+-rf\\s+\\.($|\\s|/)",
      "reason": "현재 디렉토리 통째 삭제"
    },
    {
      "pattern": "git\\s+push\\s+(.*\\s)?(--force|-f)\\b",
      "reason": "force push (히스토리 덮어쓰기)"
    },
    {
      "pattern": "git\\s+reset\\s+--hard(\\s|$)",
      "reason": "untracked/staged 변경 영구 손실"
    },
    {
      "pattern": "git\\s+clean\\s+-[fdx]+(\\s|$)",
      "reason": "untracked 파일 영구 삭제"
    },
    {
      "pattern": "(?i)DROP\\s+(TABLE|DATABASE|SCHEMA)\\b",
      "reason": "DB 스키마/테이블 삭제"
    },
    {
      "pattern": "(?i)TRUNCATE\\s+TABLE\\b",
      "reason": "테이블 전체 데이터 삭제"
    },
    {
      "pattern": "(?i)DELETE\\s+FROM\\s+\\w+\\s*(;|$)",
      "reason": "WHERE 없는 DELETE — 전체 행 삭제"
    },
    {
      "pattern": "sudo\\s+rm\\s+-rf",
      "reason": "권한 상승 후 강제 삭제"
    },
    {
      "pattern": ":\\(\\)\\s*\\{\\s*:\\s*\\|\\s*:\\s*&",
      "reason": "fork bomb"
    },
    {
      "pattern": "dd\\s+if=/dev/(zero|random|urandom)\\s+of=/dev/(sd|nvme|disk)",
      "reason": "디스크 직접 쓰기 — 파괴적"
    },
    {
      "pattern": "mkfs\\.\\w+\\s+/dev/(sd|nvme|disk)",
      "reason": "파일시스템 포맷"
    },
    {
      "pattern": "(?i)format\\s+[a-z]:",
      "reason": "Windows 드라이브 포맷"
    },
    {
      "pattern": "shutdown\\s+(/[sr]|-[hr])\\b",
      "reason": "시스템 종료/재부팅"
    },
    {
      "pattern": "chmod\\s+-R\\s+777\\s+(/|~|\\$HOME)",
      "reason": "루트/홈 전체 777 부여"
    }
  ],
  "_note": "패턴 추가 시 분기 1회 점검. PCRE 문법, JSON escape 주의 (백슬래시 두 번)."
