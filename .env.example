# .env.example — 프로젝트별 시크릿 템플릿
# 실제 값은 _harness/projects/{프로젝트명}/.env 에 저장하고 .gitignore로 강제 제외한다.
# 이 파일 자체는 Git에 커밋해도 된다 (실제 값 없음).

# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-2

# ── API Keys ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GITHUB_TOKEN=

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=
DB_PASSWORD=

# ── OAuth / Session ──────────────────────────────────────────────────────────
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
SESSION_SECRET=

# ── 기타 프로젝트 전용 시크릿 ────────────────────────────────────────────────
# 프로젝트 이름: {프로젝트명}
# 항목 추가 시 safe_write.py의 동적 마스킹 스캔 대상이 자동 등록됨 (3단계 구현 후)
